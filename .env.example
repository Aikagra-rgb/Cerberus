# ============================================================
# Cerberus Multi-Agent DevSecOps Pipeline — Environment Config
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit your `.env` file — it is already in .gitignore.

# --- Multi-Agent Model Assignments ---
# Both keys use NVIDIA NIM's OpenAI-compatible endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Nemotron key (used for the Remediation Agent)
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# DeepSeek key (used for Triage, Research, and Guardrail Agents)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-0324

# --- Agent Timeouts ---
AGENT_TIMEOUT_SECONDS=30

# --- MITRE ATT&CK RAG ---
MITRE_DATA_PATH=data/mitre_attack.json
RAG_TOP_K=5

# --- Authentication (required) ---
# The API refuses to start until both of these are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Optional: Logging & CORS ---
# LOG_LEVEL=INFO
# LOG_JSON=0
# LOG_FILE=
# ALLOWED_ORIGINS=
# VERCEL_DOMAINS=
