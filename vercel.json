{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cerberus-gxim.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://cerberus-gxim.onrender.com/health" },
    { "source": "/ready", "destination": "https://cerberus-gxim.onrender.com/ready" },
    { "source": "/live", "destination": "https://cerberus-gxim.onrender.com/live" },
    { "source": "/metrics", "destination": "https://cerberus-gxim.onrender.com/metrics" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
